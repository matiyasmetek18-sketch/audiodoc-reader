{
  "name": "audiodoc-reader",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack document reader with streaming text-to-speech playback.",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace apps/api\" \"npm run dev --workspace apps/web\"",
    "dev:api": "npm run dev --workspace apps/api",
    "dev:web": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/web",
    "start": "npm run start --workspace apps/api",
    "lint": "npm run lint --workspace apps/web",
    "stress": "npm run stress --workspace apps/api"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
